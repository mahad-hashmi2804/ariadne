<mujoco model="city_square_world">
    <option timestep="0.002" gravity="0 0 -9.81"/>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.4 0.6 0.8" rgb2="0.8 0.9 1.0" width="512" height="512"/>
    </asset>

    <default>
        <geom friction="2.0 0.5 0.5" solref="0.02 1" solimp="0.9 0.95 0.001"/>
    </default>

    <worldbody>
        <!-- Directional Daylight & Ambient Lighting -->
        <light name="sun" pos="10 10 20" dir="-0.4 -0.4 -1" castshadow="true" diffuse="0.85 0.85 0.9" ambient="0.35 0.35 0.4"/>
        <light name="fill_light" pos="-15 -15 15" dir="0.5 0.5 -1" diffuse="0.3 0.3 0.35"/>

        <!-- Base Terrain Plane (Grass / Outskirts) -->
        <geom name="ground_plane" type="plane" size="30 30 0.1" rgba="0.22 0.26 0.2 1" friction="3.0 0.5 0.5"/>

        <!-- ========================================================= -->
        <!-- ROAD NETWORK & PAVEMENT (Z = 0.001 to 0.005)               -->
        <!-- ========================================================= -->
        <!-- Main North-South Avenue -->
        <geom name="road_ns" type="box" size="3.0 22.0 0.001" pos="0 0 0.001" rgba="0.12 0.12 0.14 1"/>
        <!-- Main East-West Street -->
        <geom name="road_ew" type="box" size="22.0 3.0 0.001" pos="0 0 0.001" rgba="0.12 0.12 0.14 1"/>

        <!-- Central Plaza Ground Pad -->
        <geom name="central_plaza" type="box" size="4.5 4.5 0.003" pos="0 0 0.003" rgba="0.4 0.4 0.42 1"/>

        <!-- Road Markings (White Dashed Lines & Stop Lines) -->
        <geom name="line_n" type="box" size="0.08 12.0 0.002" pos="0 10.0 0.002" rgba="0.9 0.9 0.95 1"/>
        <geom name="line_s" type="box" size="0.08 12.0 0.002" pos="0 -10.0 0.002" rgba="0.9 0.9 0.95 1"/>
        <geom name="line_e" type="box" size="12.0 0.08 0.002" pos="10.0 0 0.002" rgba="0.9 0.9 0.95 1"/>
        <geom name="line_w" type="box" size="12.0 0.08 0.002" pos="-10.0 0 0.002" rgba="0.9 0.9 0.95 1"/>

        <!-- Crosswalk Stripes -->
        <geom name="cw_n_1" type="box" size="0.4 0.1 0.003" pos="1.2 4.8 0.003" rgba="0.9 0.9 0.9 1"/>
        <geom name="cw_n_2" type="box" size="0.4 0.1 0.003" pos="-1.2 4.8 0.003" rgba="0.9 0.9 0.9 1"/>
        <geom name="cw_s_1" type="box" size="0.4 0.1 0.003" pos="1.2 -4.8 0.003" rgba="0.9 0.9 0.9 1"/>
        <geom name="cw_s_2" type="box" size="0.4 0.1 0.003" pos="-1.2 -4.8 0.003" rgba="0.9 0.9 0.9 1"/>

        <!-- SIDEWALKS (Elevated Z=0.02 for Tracked Curb Climbing) -->
        <geom name="sw_ne" type="box" size="8.0 8.0 0.02" pos="11.5 11.5 0.02" rgba="0.55 0.55 0.58 1"/>
        <geom name="sw_nw" type="box" size="8.0 8.0 0.02" pos="-11.5 11.5 0.02" rgba="0.55 0.55 0.58 1"/>
        <geom name="sw_sw" type="box" size="8.0 8.0 0.02" pos="-11.5 -11.5 0.02" rgba="0.55 0.55 0.58 1"/>
        <geom name="sw_se" type="box" size="8.0 8.0 0.02" pos="11.5 -11.5 0.02" rgba="0.55 0.55 0.58 1"/>

        <!-- ========================================================= -->
        <!-- BUILDINGS & ARCHITECTURE                                  -->
        <!-- ========================================================= -->
        <!-- NORTH-EAST QUADRANT (Commercial & High-Rise Tower) -->
        <geom name="bld_ne_tower" type="box" size="2.5 2.5 8.0" pos="10.0 10.0 8.0" rgba="0.18 0.28 0.38 1"/>
        <geom name="bld_ne_office" type="box" size="3.5 2.0 4.0" pos="16.5 9.0 4.0" rgba="0.3 0.35 0.4 1"/>
        <geom name="bld_ne_store" type="box" size="2.0 3.0 2.0" pos="9.5 16.0 2.0" rgba="0.55 0.45 0.35 1"/>

        <!-- NORTH-WEST QUADRANT (Industrial Zone & USAR Rubble Site) -->
        <geom name="bld_nw_warehouse" type="box" size="4.5 3.5 2.5" pos="-12.0 12.0 2.5" rgba="0.45 0.42 0.4 1"/>
        <geom name="bld_nw_collapsed" type="box" size="2.2 2.2 1.0" pos="-6.5 6.5 1.0" rgba="0.5 0.45 0.4 1"/>

        <!-- Rubble / Debris Field (Urban Search & Rescue Mobility Test) -->
        <geom name="rubble_ramp" type="box" size="0.7 0.5 0.12" pos="-5.2 4.5 0.08" euler="15 0 25" rgba="0.4 0.35 0.3 1"/>
        <geom name="rubble_block1" type="box" size="0.25 0.2 0.15" pos="-4.5 5.2 0.15" euler="5 12 -30" rgba="0.48 0.42 0.38 1"/>
        <geom name="rubble_block2" type="box" size="0.3 0.25 0.18" pos="-5.5 5.8 0.18" euler="-10 15 40" rgba="0.35 0.32 0.3 1"/>

        <!-- SOUTH-WEST QUADRANT (Residential Blocks & Narrow Alleyways) -->
        <geom name="bld_sw_apt1" type="box" size="3.0 2.8 4.0" pos="-9.5 -9.5 4.0" rgba="0.55 0.3 0.25 1"/>
        <geom name="bld_sw_apt2" type="box" size="2.5 2.8 3.5" pos="-15.5 -9.5 3.5" rgba="0.5 0.32 0.28 1"/>
        <geom name="bld_sw_retail" type="box" size="3.0 2.0 2.2" pos="-9.5 -15.5 2.2" rgba="0.65 0.6 0.5 1"/>

        <!-- SOUTH-EAST QUADRANT (Civic Center & Plaza Wall) -->
        <geom name="bld_se_civic" type="box" size="4.0 3.5 3.5" pos="11.5 -11.5 3.5" rgba="0.65 0.63 0.6 1"/>
        <geom name="bld_se_column1" type="cylinder" size="0.25 1.8" pos="6.0 -6.0 1.8" rgba="0.8 0.78 0.75 1"/>
        <geom name="bld_se_column2" type="cylinder" size="0.25 1.8" pos="6.0 -8.5 1.8" rgba="0.8 0.78 0.75 1"/>

        <!-- ========================================================= -->
        <!-- INFRASTRUCTURE & STREET PROPS                             -->
        <!-- ========================================================= -->
        <!-- Plaza Perimeter Traffic Bollards -->
        <geom name="bollard_ne" type="cylinder" size="0.08 0.4" pos="3.8 3.8 0.4" rgba="0.8 0.2 0.2 1"/>
        <geom name="bollard_nw" type="cylinder" size="0.08 0.4" pos="-3.8 3.8 0.4" rgba="0.8 0.2 0.2 1"/>
        <geom name="bollard_sw" type="cylinder" size="0.08 0.4" pos="-3.8 -3.8 0.4" rgba="0.8 0.2 0.2 1"/>
        <geom name="bollard_se" type="cylinder" size="0.08 0.4" pos="3.8 -3.8 0.4" rgba="0.8 0.2 0.2 1"/>

        <!-- Concrete Jersey Barriers -->
        <geom name="barrier_east" type="box" size="0.15 1.0 0.3" pos="4.2 0 0.3" rgba="0.85 0.5 0.1 1"/>
        <geom name="barrier_west" type="box" size="0.15 1.0 0.3" pos="-4.2 0 0.3" rgba="0.85 0.5 0.1 1"/>
    </worldbody>

    <!-- Include robot definition -->
    <include file="robot.xml"/>
</mujoco>