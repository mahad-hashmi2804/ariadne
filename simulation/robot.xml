<mujoco model="invertible_tracked_robot">
    <default>
        <!-- High longitudinal traction (2.5), lower lateral skid friction (0.3) -->
        <geom rgba="0.2 0.2 0.25 1" friction="2.5 0.3 0.1"/>
        <joint type="hinge" damping="0.3" armature="0.01"/>
        <velocity kv="120" forcerange="-60 60"/>
    </default>

    <worldbody>
        <body name="torso" pos="0 0 0.09">
            <freejoint name="root"/>

            <!-- Centered forward camera for symmetrical body layout -->
            <camera name="front_cam" pos="0.22 0 0.0" xyaxes="0 -1 0 0 0 1"/>

            <!-- Slim chassis box (Thickness = 0.07m) -->
            <geom name="chassis" type="box" size="0.22 0.14 0.035" rgba="0.75 0.75 0.8 1" mass="6.0"/>

            <!-- LEFT TRACK DRIVE WHEELS (+Y) - Radius 0.06m extends above and below chassis -->
            <body name="left_front_wheel" pos="0.16 0.18 0">
                <joint name="left_front_joint" axis="0 1 0"/>
                <geom type="cylinder" size="0.06 0.03" fromto="0 -0.015 0  0 0.015 0" rgba="0.1 0.1 0.1 1" mass="0.8"/>
            </body>
            <body name="left_rear_wheel" pos="-0.16 0.18 0">
                <joint name="left_rear_joint" axis="0 1 0"/>
                <geom type="cylinder" size="0.06 0.03" fromto="0 -0.015 0  0 0.015 0" rgba="0.1 0.1 0.1 1" mass="0.8"/>
            </body>

            <!-- RIGHT TRACK DRIVE WHEELS (-Y) -->
            <body name="right_front_wheel" pos="0.16 -0.18 0">
                <joint name="right_front_joint" axis="0 1 0"/>
                <geom type="cylinder" size="0.06 0.03" fromto="0 -0.015 0  0 0.015 0" rgba="0.1 0.1 0.1 1" mass="0.8"/>
            </body>
            <body name="right_rear_wheel" pos="-0.16 -0.18 0">
                <joint name="right_rear_joint" axis="0 1 0"/>
                <geom type="cylinder" size="0.06 0.03" fromto="0 -0.015 0  0 0.015 0" rgba="0.1 0.1 0.1 1" mass="0.8"/>
            </body>
        </body>
    </worldbody>

    <!-- Velocity Actuators: Actuator 0,1 = Left Track | Actuator 2,3 = Right Track -->
    <actuator>
        <velocity joint="left_front_joint" name="left_drive_f"/>
        <velocity joint="left_rear_joint" name="left_drive_r"/>
        <velocity joint="right_front_joint" name="right_drive_f"/>
        <velocity joint="right_rear_joint" name="right_drive_r"/>
    </actuator>
</mujoco>