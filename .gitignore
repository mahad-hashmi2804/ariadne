# =========================================================================
# Rust / Cargo Specific
# =========================================================================
# The following ignores build outputs, caches, and test artifacts
detection/target/
movement/target/
simulation/target/

# Generated by Cargo when running tests or benchmarks
# If you are using cargo-mutants, ignore its output
**/mutants.out/

# Backup files generated by tools like rustfmt
*.rs.bk

# MSVC Windows builds of rustc generate these debugging symbols
*.pdb

# Rust compiler crash/internal error logs
rustc-ice-*.txt

# =========================================================================
# JetBrains RustRover Specific (.idea folder)
# =========================================================================
# Ignore the entire IDE configuration folder by default
.idea/

# OPTIONAL: If you want to share specific configurations with team members,
# uncomment the lines below to allow versioning of run/debug tasks.
 !.idea/runConfigurations/
 !.idea/deployment.xml
 !.idea/vcs.xml

# Ignore local user-specific overrides, workspace states, and shelf tasks
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.idea/**/dictionaries
.idea/**/shelf/

# Ignore CMake build outputs if using custom native plugins
/cmake-build-debug/
/cmake-build-release/

# =========================================================================
# Operating System Specific
# =========================================================================
.DS_Store
Thumbs.db

# Ignore build artifacts from all crates
**/target/

# Ignore JetBrains / RustRover local settings
**/ .idea/

# Ignore local lockfiles if you want to manage them at the root level later
# Cargo.lock

/.cargo/config.toml
